<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sortie_caisse_regle_validation_list" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.regle.validation.list</field>
        <field name="model">ar.sortie.caisse.regle.validation</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="name"/>
                <field name="montant_min"/>
                <field name="montant_max"/>
                <field name="tresorier_id"/>
                <field name="validateur_fi_id"/>
                <field name="validateur_md_id"/>
            </list>
        </field>
    </record>

    <record id="view_sortie_caisse_regle_validation_form" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.regle.validation.form</field>
        <field name="model">ar.sortie.caisse.regle.validation</field>
        <field name="arch" type="xml">
            <form string="Règle de validation">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="name" readonly="1"/>
                    </group>
                    <group>
                        <group string="Marge du prix">
                            <field name="montant_min"/>
                            <field name="montant_max"/>
                        </group>
                        <group string="Validateurs">
                            <field name="tresorier_id"/>
                            <field name="validateur_fi_id"/>
                            <field name="validateur_md_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sortie_caisse_regle_validation" model="ir.actions.act_window">
        <field name="name">Paramétrage</field>
        <field name="res_model">ar.sortie.caisse.regle.validation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
