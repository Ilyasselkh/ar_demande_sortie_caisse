<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sortie_caisse_ai_create_wizard_form" model="ir.ui.view">
        <field name="name">ar.demande.sortie.caisse.ai.create.wizard.form</field>
        <field name="model">ar.demande.sortie.caisse.ai.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Chatbot IA - Demande sortie caisse">
                <sheet>
                    <group string="Conversation">
                        <field name="message_ids" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="role" widget="badge"/>
                                <field name="content"/>
                            </list>
                        </field>
                        <field name="user_message"
                               nolabel="1"
                               placeholder="Écrivez votre message ici. Exemple : Je veux demander 300 DH pour acheter des fournitures bureau..."/>
                        <field name="prompt" invisible="1"/>
                    </group>
                    <group string="Brouillon préparé par le chatbot" col="4">
                        <field name="ready_to_create" colspan="2" widget="boolean_toggle"/>
                        <field name="type_demande" colspan="2"/>
                        <field name="type_demande_autre"
                               colspan="2"
                               invisible="type_demande != 'autre'"
                               required="type_demande == 'autre'"/>
                        <field name="confidence" colspan="2" widget="badge"/>
                        <field name="description_demande" colspan="4"/>
                        <field name="missing_info" colspan="2"/>
                        <field name="agent_reasoning" colspan="2"/>
                    </group>
                    <group string="Lignes de dépense proposées">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="commande"/>
                                <field name="quantite"/>
                                <field name="prix"/>
                                <field name="sous_total" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <field name="raw_response" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_send_message"
                            string="Envoyer"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_create_demande"
                            string="Créer la demande"
                            type="object"
                            class="btn-success"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sortie_caisse_ai_create" model="ir.actions.act_window">
        <field name="name">Chatbot IA</field>
        <field name="res_model">ar.demande.sortie.caisse.ai.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_sortie_caisse_ai_config_wizard_form" model="ir.ui.view">
        <field name="name">ar.demande.sortie.caisse.ai.config.wizard.form</field>
        <field name="model">ar.demande.sortie.caisse.ai.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Configuration agent IA">
                <sheet>
                    <group>
                        <field name="openai_api_key" password="True"/>
                        <field name="openai_model" placeholder="gpt-5.4-mini"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save"
                            string="Enregistrer"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sortie_caisse_ai_config" model="ir.actions.act_window">
        <field name="name">Agent IA</field>
        <field name="res_model">ar.demande.sortie.caisse.ai.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
