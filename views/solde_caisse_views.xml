<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sortie_caisse_solde_list" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.solde.list</field>
        <field name="model">ar.sortie.caisse.solde</field>
        <field name="arch" type="xml">
            <list>
                <field name="can_manage_active" column_invisible="1"/>
                <field name="name"/>
                <field name="solde_courant"/>
                <field name="active" widget="boolean_toggle" readonly="not can_manage_active"/>
            </list>
        </field>
    </record>

    <record id="view_sortie_caisse_solde_form" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.solde.form</field>
        <field name="model">ar.sortie.caisse.solde</field>
        <field name="arch" type="xml">
            <form string="Solde de Caisse">
                <header>
                    <button name="action_alimenter"
                            string="Alimenter"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <field name="can_manage_active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Solde">
                            <field name="solde_courant" readonly="id"/>
                            <field name="active" readonly="not can_manage_active"/>
                        </group>
                        <group string="Alimentation">
                            <field name="alimentation_type" required="alimentation_montant &gt; 0"/>
                            <field name="alimentation_montant"/>
                            <field name="alimentation_note"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historique">
                            <field name="mouvement_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="date_mouvement"/>
                                    <field name="mouvement_type" widget="badge"/>
                                    <field name="alimentation_type"/>
                                    <field name="montant" sum="Total"/>
                                    <field name="solde_avant"/>
                                    <field name="solde_apres"/>
                                    <field name="demande_id"/>
                                    <field name="user_id"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sortie_caisse_solde_search" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.solde.search</field>
        <field name="model">ar.sortie.caisse.solde</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Actifs" name="filter_active" domain="[('active','=',True)]"/>
                <filter string="Archivés" name="filter_inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_sortie_caisse_mouvement_list" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.mouvement.list</field>
        <field name="model">ar.sortie.caisse.mouvement</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date_mouvement"/>
                <field name="solde_id"/>
                <field name="mouvement_type" widget="badge"/>
                <field name="alimentation_type"/>
                <field name="montant" sum="Total"/>
                <field name="solde_avant"/>
                <field name="solde_apres"/>
                <field name="demande_id"/>
                <field name="user_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_sortie_caisse_mouvement_search" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.mouvement.search</field>
        <field name="model">ar.sortie.caisse.mouvement</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_mouvement"/>
                <field name="solde_id"/>
                <field name="demande_id"/>
                <field name="mouvement_type"/>
                <field name="alimentation_type"/>
                <filter string="Période personnalisée" name="filter_period" date="date_mouvement"/>
                <filter string="Ce mois" name="filter_current_month"
                        domain="[('date_mouvement','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="Augmentations" name="filter_augmentation" domain="[('mouvement_type','=','augmentation')]"/>
                <filter string="Déductions" name="filter_deduction" domain="[('mouvement_type','=','deduction')]"/>
                <separator/>
                <filter string="Rendu régularisation" name="filter_reste" domain="[('alimentation_type','=','reste_regularisation')]"/>
                <filter string="Vente déchets" name="filter_dechets" domain="[('alimentation_type','=','vente_dechets')]"/>
                <filter string="Banque" name="filter_banque" domain="[('alimentation_type','=','banque')]"/>
                <group>
                    <filter string="Type mouvement" name="group_mouvement_type" context="{'group_by': 'mouvement_type'}"/>
                    <filter string="Type alimentation" name="group_alimentation_type" context="{'group_by': 'alimentation_type'}"/>
                    <filter string="Mois" name="group_month" context="{'group_by': 'date_mouvement:month'}"/>
                    <filter string="Utilisateur" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
                <searchpanel>
                    <field name="mouvement_type" string="Type mouvement" select="multi" enable_counters="1"/>
                    <field name="alimentation_type" string="Type alimentation" select="multi" enable_counters="1"/>
                    <field name="user_id" string="Utilisateur" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_sortie_caisse_mouvement_pivot" model="ir.ui.view">
        <field name="name">ar.sortie.caisse.mouvement.pivot</field>
        <field name="model">ar.sortie.caisse.mouvement</field>
        <field name="arch" type="xml">
            <pivot string="Historique de Caisse">
                <field name="alimentation_type" type="row"/>
                <field name="mouvement_type" type="col"/>
                <field name="montant" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_sortie_caisse_solde" model="ir.actions.act_window">
        <field name="name">Solde de Caisse</field>
        <field name="res_model">ar.sortie.caisse.solde</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sortie_caisse_solde_search"/>
        <field name="context">{'form_view_initial_mode': 'edit', 'active_test': False}</field>
    </record>

    <record id="action_sortie_caisse_mouvements" model="ir.actions.act_window">
        <field name="name">Historique de Caisse</field>
        <field name="res_model">ar.sortie.caisse.mouvement</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_sortie_caisse_mouvement_search"/>
        <field name="context">{'ar_caisse_period_panel': True}</field>
    </record>
</odoo>
