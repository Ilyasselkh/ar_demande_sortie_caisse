<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_sortie_caisse_to_n1" model="mail.template">
            <field name="name">Sortie Caisse - Validation N+1</field>
            <field name="model_id" ref="model_ar_demande_sortie_caisse"/>
            <field name="subject">[Sortie Caisse] {{ object.name }} - Validation N+1 requise</field>
            <field name="email_from">Sortie Caisse &lt;AR-ARMaroc@araymond.com&gt;</field>
            <field name="email_to"></field>
            <field name="body_html" type="html">
                <div>
                    <p>Bonjour,</p>
                    <p>Une demande de sortie de caisse nécessite votre validation N+1.</p>
                    <p><b>Référence :</b> <t t-out="object.name"/></p>
                    <p><b>Demandeur :</b> <t t-out="object.demandeur_id.name or ''"/></p>
                    <p><b>Département :</b> <t t-out="object.department_id.name or ''"/></p>
                    <p><b>Montant demandé :</b> <t t-out="object.montant_demande"/></p>
                    <p><b>Total des prix :</b> <t t-out="object.total_prix"/></p>
                    <t t-if="object.description_demande">
                        <p><b>Description :</b> <t t-out="object.description_demande"/></p>
                    </t>
                    <t t-set="base_url" t-value="object.get_base_url()"/>
                    <div style="margin: 16px 0px;">
                        <a t-attf-href="{{ base_url }}/web#id={{ object.id }}&amp;model=ar.demande.sortie.caisse&amp;view_type=form"
                           style="background-color:#1481f4;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;font-size:13px;">
                            Ouvrir la demande
                        </a>
                    </div>
                </div>
            </field>
        </record>

